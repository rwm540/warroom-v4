# Public values embedded in the browser bundle. Never put service-role keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Private Node API values. Keep this file out of Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
JWT_SECRET=replace_with_random_secret_at_least_32_characters
OTP_SECRET=replace_with_a_different_random_secret_at_least_32_characters
# Optional: generate privately for initial admin setup, then remove.
ADMIN_BOOTSTRAP_TOKEN=
IPPANEL_API_KEY=replace_with_ippanel_key
IPPANEL_FROM_NUMBER=replace_with_verified_sender
OTP_TTL_SECONDS=300
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=4010
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGINS=https://your-production-domain.example
