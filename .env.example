# =============================================================================
# WarRoom V4 - .env.example
# Copy to .env and fill with real values. Never commit .env with secrets.
# =============================================================================
# PUBLIC vs PRIVATE:
# - VITE_* variables are embedded in browser bundle at build time (public)
#   Only anon/publishable keys are safe here.
# - All other variables are server-only (private), never exposed to frontend
# - Secrets must be runtime injected, never baked into Docker images

# --------------------------
# Frontend Public (VITE_*)
# Safe to expose in browser bundle, required at build time
# --------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy compatibility - use publishable key preferentially
# VITE_SUPABASE_ANON_KEY=your_anon_jwt
# VITE_SUPABASE_PUBLIC_KEY=your_public_key

# --------------------------
# Backend Private - Supabase
# Server-only, runtime injection via docker-compose env or host env
# Never use VITE_ prefix, never commit real values
# --------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_never_anon_key

# --------------------------
# Backend Private - OTP Security
# Runtime only, >=32 chars, cryptographically random
# Generate with: openssl rand -base64 32
# OTP_SECRET and OTP_CHALLENGE_SECRET must be different
# --------------------------
OTP_CHALLENGE_SECRET=replace_with_random_secret_at_least_32_characters
OTP_SECRET=replace_with_a_different_random_secret_at_least_32_characters
OTP_TTL_SECONDS=120
OTP_MAX_SEND_PER_15MIN=3
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_MAX_VERIFY_ATTEMPTS=5

# --------------------------
# Backend Private - SMS Provider (IPPanel)
# Runtime only; missing configuration disables SMS even in development
# --------------------------
IPPANEL_API_KEY=replace_with_ippanel_key
IPPANEL_FROM_NUMBER=+983000505
IPPANEL_PATTERN_CODE=mf31w8ng9vnoqy5
IPPANEL_API_URL=https://edge.ippanel.com/v1/api/send

# --------------------------
# Backend Private - Rate Limits
# --------------------------
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
REGISTRATION_RATE_LIMIT_PER_HOUR=5

# --------------------------
# Backend Private - Redis
# Server-only, never VITE_. Used for atomic rate limiting (INCR+TTL) via Lua script
# In Docker: redis://:password@redis:6379 (service name, not localhost)
# Local dev: redis://:password@localhost:6379
# Format must start with redis:// or rediss://, otherwise rejected by config validation
# No default password allowed - must be set, min 16 chars recommended, 8 chars minimum
# Memory policy: noeviction (prevents silent counter eviction, fail-closed on memory full)
# --------------------------
REDIS_URL=redis://:replace_with_redis_password@redis:6379
REDIS_PASSWORD=replace_with_strong_redis_password_at_least_16_chars

# --------------------------
# Backend Private - Session Security
# HttpOnly, Secure, SameSite cookies for session management
# SESSION_SECRET optional - falls back to OTP_CHALLENGE_SECRET if not set
# COOKIE_SECURE=true in production (requires HTTPS)
# --------------------------
SESSION_SECRET=replace_with_random_secret_at_least_32_chars_for_sessions
COOKIE_SECURE=true

# --------------------------
# Backend Server Config
# PORT/HOST/NODE_ENV/TRUST_PROXY must match docker-compose and server_node/src/config.js
# --------------------------
PORT=4010
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=1
# Final public website origin(s), comma-separated; no trailing slash.
# Required by docker-compose for CORS and CSRF origin checks.
ALLOWED_ORIGINS=https://warroom.example.com

# --------------------------
# Docker Compose Specific
# WEB_PORT: only web service published to host, bound to 127.0.0.1 for security
# Nginx listens 8080 internally (non-root), mapped to host 3100
# --------------------------
WEB_PORT=127.0.0.1:3100:8080

# --------------------------
# Documentation - How to create .env
# --------------------------
# 1. cp .env.example .env
# 2. Fill all required values (marked with :? in docker-compose.yml will fail if missing)
#    - REDIS_PASSWORD is now REQUIRED, no default (was warroom_local_redis_pass, now rejected)
#    - Generate: openssl rand -base64 24 for Redis (16+ chars)
#    - Generate: openssl rand -base64 32 for OTP secrets (must differ)
# 3. For local Docker: docker compose --env-file .env up --build
# 4. For frontend only: npm run dev (needs VITE_ vars)
# 5. For backend only: npm --prefix server_node run dev (needs server vars)
# 6. Never put service_role key in VITE_ variables
# 7. Never commit .env, only .env.example with placeholders
# 8. Redis: noeviction policy, healthcheck uses REDISCLI_AUTH env not -a arg (no leak in ps)
