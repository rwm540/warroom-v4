# Public values embedded in the browser bundle. Never put service-role keys here.
# These are safe to expose in the frontend bundle (anon/publishable keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Optional legacy keys - prefer publishable key format
# VITE_SUPABASE_ANON_KEY=your_anon_jwt
# VITE_SUPABASE_PUBLIC_KEY=your_public_key

# Private Node OTP API values. Keep real values outside Git and never use VITE_* names.
# All values below must be set in server_node/.env or environment, never in Vercel frontend env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
OTP_CHALLENGE_SECRET=replace_with_random_secret_at_least_32_characters
OTP_SECRET=replace_with_a_different_random_secret_at_least_32_characters
# OTP secrets must be different, >=32 chars, cryptographically random (e.g. openssl rand -base64 32)
OTP_TTL_SECONDS=300
OTP_MAX_SEND_PER_15MIN=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
IPPANEL_API_KEY=replace_with_ippanel_key
IPPANEL_FROM_NUMBER=+983000505
IPPANEL_API_URL=https://edge.ippanel.com/v1/api/send
PORT=4010
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=1
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
REGISTRATION_RATE_LIMIT_PER_HOUR=5
# Optional Redis for session storage (server only, never VITE_)
# REDIS_URL=redis://localhost:6379
