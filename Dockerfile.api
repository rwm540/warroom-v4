# Dockerfile.api - Production for Node.js OTP/Registration/PasswordReset API
FROM node:22-alpine

ENV NODE_ENV=production
ENV PORT=4010
ENV HOST=0.0.0.0

WORKDIR /app

# Copy dependency files first
COPY server_node/package.json server_node/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

# Copy source
COPY server_node/src ./src

# Create non-root user
RUN addgroup -S warroom && adduser -S warroom -G warroom && \
    chown -R warroom:warroom /app

# Never bake secrets into image - they are injected at runtime via env
# Healthcheck uses internal fetch, no external dependencies
USER warroom

EXPOSE 4010

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4010/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["npm", "start"]
