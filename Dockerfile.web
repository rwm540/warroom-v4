# Dockerfile.web - Production build for React/Vite frontend with Nginx
# Multi-stage build for minimal image size and security

FROM node:22-alpine AS build
WORKDIR /app

# Copy dependency files first for better caching
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source and build
COPY . .
# Build args for public Supabase keys only - never service_role
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_PUBLIC_KEY

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_PUBLIC_KEY=$VITE_SUPABASE_PUBLIC_KEY

RUN npm run build

# Production stage with Nginx, non-root user
FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Create non-root user for nginx
RUN addgroup -S warroom && adduser -S warroom -G warroom && \
    chown -R warroom:warroom /usr/share/nginx/html && \
    chown -R warroom:warroom /var/cache/nginx && \
    chown -R warroom:warroom /var/log/nginx && \
    chown -R warroom:warroom /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R warroom:warroom /var/run/nginx.pid

# Security headers handled in nginx.conf
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

# Use non-root
USER warroom

CMD ["nginx", "-g", "daemon off;"]
