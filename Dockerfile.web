# Dockerfile.web - Production build for React/Vite frontend with Nginx
# Multi-stage build, non-root user, port 8080

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
# Use npm ci for locked deps, ignore-scripts checked - build does not need postinstall
# sharp has optional postinstall but vite build works without it (fallback)
RUN npm ci --ignore-scripts

COPY . .
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_PUBLIC_KEY

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_PUBLIC_KEY=$VITE_SUPABASE_PUBLIC_KEY

RUN npm run build

FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config (listens 8080 for non-root)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Create non-root user and prepare writable dirs for nginx on 8080
RUN addgroup -S warroom && adduser -S warroom -G warroom && \
    mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
    chown -R warroom:warroom /usr/share/nginx/html && \
    chown -R warroom:warroom /var/cache/nginx && \
    chown -R warroom:warroom /var/log/nginx && \
    chown -R warroom:warroom /etc/nginx/conf.d && \
    chown -R warroom:warroom /var/run && \
    touch /var/run/nginx.pid && \
    chown warroom:warroom /var/run/nginx.pid

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

USER warroom

CMD ["nginx", "-g", "daemon off;"]
