# Docker .env sample - no real secrets, placeholders only
# Copy to ../.env and fill with real values outside Git
# This file is safe to commit (placeholders only)

# Public frontend (safe for bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_ANON_KEY=your_anon_jwt_optional
VITE_SUPABASE_PUBLIC_KEY=your_public_key_optional

# Private backend - required, runtime only, never VITE_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# OTP secrets - must be >=32 chars, different, random: openssl rand -base64 32
OTP_CHALLENGE_SECRET=replace_with_32_chars_min_secret_1
OTP_SECRET=replace_with_32_chars_min_secret_2_different
OTP_TTL_SECONDS=120
OTP_MAX_SEND_PER_15MIN=3
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_MAX_VERIFY_ATTEMPTS=5

# Redis - REQUIRED, no default, min 16 chars recommended, 8 min
# In Docker, service name is redis, not localhost
REDIS_PASSWORD=replace_with_strong_password_16_chars_min
REDIS_URL=redis://:replace_with_strong_password_16_chars_min@redis:6379

# Session security
SESSION_SECRET=replace_with_random_secret_at_least_32_chars_for_sessions
COOKIE_SECURE=true

# SMS provider - required for OTP delivery
IPPANEL_API_KEY=
IPPANEL_FROM_NUMBER=+983000505
IPPANEL_PATTERN_CODE=mf31w8ng9vnoqy5
IPPANEL_API_URL=https://edge.ippanel.com/v1/api/send

# Rate limits
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
REGISTRATION_RATE_LIMIT_PER_HOUR=5

# Server config
PORT=4010
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=1
WEB_PORT=127.0.0.1:3100:8080
