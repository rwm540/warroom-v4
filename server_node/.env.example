PORT=4010
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
JWT_SECRET=replace_with_random_secret_at_least_32_characters
OTP_SECRET=replace_with_a_different_random_secret_at_least_32_characters
# Optional one-time secret; remove after the initial admin credential is provisioned.
ADMIN_BOOTSTRAP_TOKEN=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OTP_TTL_SECONDS=300
OTP_MAX_SEND_PER_15MIN=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
IPPANEL_API_KEY=replace_with_ippanel_key
IPPANEL_FROM_NUMBER=replace_with_verified_sender
